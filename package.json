{
  "name": "shopee-mobile-api-interceptor",
  "version": "1.0.0",
  "description": "Advanced Shopee Scraping via Mobile Application Native App API Interception",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "analyze-apk": "ts-node src/mobile/reverse-engineering/apk-analyzer.ts",
    "discover-endpoints": "ts-node src/mobile/reverse-engineering/endpoint-discovery.ts",
    "analyze-and-discover": "npm run analyze-apk && npm run discover-endpoints",
    "setup:frida": "ts-node scripts/setup-frida.ts",
    "capture-traffic": "ts-node scripts/capture-traffic.ts",
    "extract-tokens": "ts-node scripts/extract-tokens.ts",
    "deploy-device-farm": "ts-node scripts/deploy-device-farm.ts",
    "start:mobile": "node dist/index.js",
    "dev:mobile": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "device-detector-js": "^3.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.2",
    "jsdom": "^23.0.1",
    "node-cache": "^5.1.2",
    "node-html-parser": "^6.1.5",
    "playwright": "^1.40.0",
    "puppeteer": "^21.5.0",
    "redis": "^4.6.5",
    "socks-proxy-agent": "^8.0.2",
    "user-agents": "^1.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.16",
    "@types/crypto-js": "^4.1.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.5",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.8.6",
    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.10",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.52.0",
    "frida-tools": "^1.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
