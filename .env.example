# Mobile API Configuration
SHOPEE_MOBILE_BASE_URL=https://shopee.co.id/api/v4
SHOPEE_MOBILE_APP_VERSION=4.0.0
SHOPEE_MOBILE_PACKAGE=com.shopee.id

# Device Configuration
DEVICE_FARM_SIZE=10
ANDROID_HOME=/path/to/android-sdk
FRIDA_SERVER_VERSION=16.1.0

# Proxy Configuration
PROXY_HOST=localhost
PROXY_PORT=8080
PROXY_AUTH=username:password

# Authentication
ACCOUNT_POOL_PATH=./data/accounts.json
TOKEN_REFRESH_INTERVAL=3600000

# Scaling Configuration
MAX_CONCURRENT_REQUESTS=100
RATE_LIMIT_PER_DEVICE=1000
BURST_SIZE=50

# Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=300

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/mobile.log